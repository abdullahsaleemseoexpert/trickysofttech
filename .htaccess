RewriteEngine On

# www -> non-www
RewriteCond %{HTTP_HOST} ^www\.trickysofttech\.com [NC]
RewriteRule ^(.*)$ https://trickysofttech.com/$1 [L,R=301]

# Strip index.html from any URL (e.g. /index.html -> /, /services/index.html -> /services/)
RewriteCond %{THE_REQUEST} /index\.html[\s?] [NC]
RewriteRule ^(.*)index\.html$ /$1 [R=301,L]
